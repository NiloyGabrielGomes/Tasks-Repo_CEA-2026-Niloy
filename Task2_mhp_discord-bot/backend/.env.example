# ── Discord OAuth2 / Bot ───────────────────────────────────────────────────────
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
# The Discord server (guild) where MHP operates — used to verify roles
DISCORD_GUILD_ID=your_guild_snowflake_id

# ── Auth (Internal JWTs issued after Discord OAuth2 validates the user) ────────
SECRET_KEY=your_secret_key_here_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Policy ─────────────────────────────────────────────────────────────────────
# Cut-off time in HH:MM (24-hour), evaluated in Asia/Dhaka (UTC+6)
CUTOFF_TIME=21:00
WFH_MONTHLY_CAP=5

# ── Storage ────────────────────────────────────────────────────────────────────
# "dynamodb" uses AWS DynamoDB (default/production)
STORAGE_BACKEND=dynamodb

# Required only when STORAGE_BACKEND=s3
AWS_REGION=ap-southeast-1
S3_BUCKET=mhp-data-bucket
S3_PREFIX=mhp/

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Discord Application ──────────────────────────────────────────────────────────
# Get these from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_PUBLIC_KEY=your_discord_public_key_hex
DISCORD_APPLICATION_ID=your_discord_application_id
DISCORD_GUILD_ID=your_guild_snowflake_id
DISCORD_REDIRECT_URI=

# ── Role Mapping ────────────────────────────────────────────────────────────────
# Discord role names (display names for logging)
ROLE_ADMIN=MHP-Admin
ROLE_TEAM_LEAD=MHP-TeamLead
ROLE_EMPLOYEE=MHP-Employee

# Discord role IDs (right-click role → Copy ID with Developer Mode ON)
ROLE_ADMIN_ID=
ROLE_TEAM_LEAD_ID=

# ── AWS ──────────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
DYNAMODB_TABLE_NAME=trainee-2026-niloy-mhp-data
S3_BUCKET=trainee-2026-niloy-mhp-reports
S3_PREFIX=reports/

# ── Policy ─────────────────────────────────────────────────────────────────────
# Cut-off time in HH:MM (24-hour), evaluated in Asia/Dhaka (UTC+6)
CUTOFF_TIME=21:00
WFH_MONTHLY_CAP=5
FORWARD_PLANNING_DAYS=7
TIMEZONE=Asia/Dhaka

# ── Environment ────────────────────────────────────────────────────────────────
DEBUG=true
ENVIRONMENT=dev

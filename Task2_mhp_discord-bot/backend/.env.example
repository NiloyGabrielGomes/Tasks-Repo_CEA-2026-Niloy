# ── Discord Application ──────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token

DISCORD_PUBLIC_KEY=your_discord_public_key_hex

DISCORD_GUILD_ID=your_guild_snowflake_id

DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Role Mapping ────────────────────────────────────────────────────────────────
# Discord role names that map to application roles
ROLE_ADMIN=MHP-Admin
ROLE_TEAM_LEAD=MHP-TeamLead
ROLE_EMPLOYEE=MHP-Employee

ROLE_ADMIN_ID=
ROLE_TEAM_LEAD_ID=

SECRET_KEY=your_secret_key_here_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AWS ──────────────────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
DYNAMODB_TABLE_NAME=MHP-Data
S3_BUCKET=mhp-reports
S3_PREFIX=reports/

# ── Policy ─────────────────────────────────────────────────────────────────────
# Cut-off time in HH:MM (24-hour), evaluated in Asia/Dhaka (UTC+6)
CUTOFF_TIME=21:00
WFH_MONTHLY_CAP=5

# ── Environment ────────────────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=development
